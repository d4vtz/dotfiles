{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "padding": {
            "top": 1,
            "right": 3
        },
        "color": {
            "1": "magenta",
            "2": "cyan"
        }
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys": "magenta",
            "title": "cyan"
        },
        "percent": {
            "type": 9
        }
    },

    "modules": [
        "title",
        "separator",

        {
            "type": "os",
            "key": "󰣇 OS"
        },
        {
            "type": "host",
            "key": "󰌢 Equipo"
        },
        {
            "type": "kernel",
            "key": "󰒋 Kernel"
        },
        {
            "type": "uptime",
            "key": "󰅐 Actividad"
        },
        {
            "type": "packages",
            "key": "󰏖 Paquetes"
        },
        {
            "type": "shell",
            "key": "󰆍 Shell"
        },

        "break",

        {
            "type": "display",
            "key": "󰍹 Pantalla"
        },
        {
            "type": "de",
            "key": "󰧨 Escritorio"
        },
        {
            "type": "wm",
            "key": "󰖲 Compositor"
        },
        {
            "type": "terminal",
            "key": "󰆍 Terminal"
        },
        {
            "type": "terminalfont",
            "key": "󰛖 Fuente"
        },

        "break",

        {
            "type": "cpu",
            "key": "󰻠 CPU"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU"
        },
        {
            "type": "memory",
            "key": "󰍛 Memoria"
        },
        {
            "type": "swap",
            "key": "󰓡 Swap"
        },
        {
            "type": "disk",
            "key": "󰋊 Disco"
        },
        {
            "type": "battery",
            "key": "󰁹 Batería"
        },

        "break",
        "colors"
    ]
}
